{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "checker.krk.team"
        }
      ],
      "destination": "https://labelpass.kr/:path*",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/pricing#faq",
      "permanent": false
    },
    {
      "source": "/guide/label",
      "destination": "https://blog.labelpass.kr/category/guide",
      "permanent": true
    },
    {
      "source": "/guide/rejection",
      "destination": "https://blog.labelpass.kr",
      "permanent": true
    },
    {
      "source": "/blog/krk-checker-label-review-result",
      "destination": "https://blog.labelpass.kr/labelpass-label-review-result",
      "permanent": true
    },
    {
      "source": "/blog{/}?",
      "destination": "https://blog.labelpass.kr",
      "permanent": true
    },
    {
      "source": "/blog/:path+",
      "destination": "https://blog.labelpass.kr/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/service",
      "destination": "/service.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
