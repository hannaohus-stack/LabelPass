{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/faq",
      "destination": "/pricing#faq",
      "permanent": false
    },
    {
      "source": "/guide/label",
      "destination": "/blog/category/guide",
      "permanent": true
    },
    {
      "source": "/guide/rejection",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/krk-checker-label-review-result",
      "destination": "/blog/labelpass-label-review-result",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/service",
      "destination": "/service.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/category/:cat",
      "destination": "/blog/category/:cat/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
