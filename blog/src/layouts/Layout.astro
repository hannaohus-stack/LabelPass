---
import '../styles/site.css';
import { CATS, SITE, link } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  /** 지금 보고 있는 카테고리 (상단 메뉴 강조) */
  cat?: string;
}
const { title, description, type = 'website', image, cat } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const LOGO_W = '/site/LabelPass_Logo_Primary_White_v1.0.svg';
const LOGO_B = '/site/LabelPass_Logo_Primary_Blue_v1.0.svg';
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content={type}>
<meta property="og:site_name" content="라벨패스 LabelPass">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
{ogImage && <meta property="og:image" content={ogImage}>}
<meta property="og:locale" content="ko_KR">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<slot name="head" />
<script async src="https://www.googletagmanager.com/gtag/js?id=G-5QYQQ49EGR"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-5QYQQ49EGR',{anonymize_ip:true});</script>
<script is:inline>(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script","wwzyi71k5m");</script>
</head>
<body class="solid blog">
<header class="bnav">
 <div class="wrap bnav-in">
  <a class="bnav-logo" href={link()} aria-label="라벨패스 블로그 홈"><img src={LOGO_B} alt="LabelPass 라벨패스" width="102" height="40"><span>BLOG</span></a>
  <nav class="bnav-cats" aria-label="카테고리">
   {CATS.map((c) => <a href={link(`/category/${c.k}`)} aria-current={cat === c.k ? 'page' : undefined}>{c.name}</a>)}
  </nav>
  <a class="btn btn-blue btn-sm bnav-cta" href={`${SITE}/creator`}>무료 라벨 점검</a>
 </div>
</header>

<main>
<slot />
<section class="bigcta" aria-labelledby="cta-h">
 <svg class="bigcta-arrow" viewBox="0 0 100 100" aria-hidden="true"><polygon points="0,0 100,0 100,100 72,100 72,47.80 19.80,100 0,80.20 52.20,28 0,28"/></svg>
 <div class="wrap">
  <div class="kicker">TALK TO US</div>
  <h2 id="cta-h">라벨 확인이 처음이라면,<br>먼저 상담부터 받아보세요</h2>
  <p>라벨 사진만 보내주시면, 우리 제품에 맞는 검토 방법을 직접 안내해 드립니다.</p>
  <div class="bigcta-act">
   <a class="btn btn-white" href="#kakao">카톡으로 상담하기 <span aria-hidden="true">↗</span></a>
   <a class="btn btn-wline" href={`${SITE}/contact`}>파트너 도입문의</a>
  </div>
 </div>
</section>
</main>

<footer class="footer">
 <div class="wrap">
  <div class="foot-top">
   <img src={LOGO_B} alt="LabelPass 라벨패스" width="102" height="40">
   <nav class="foot-links" aria-label="푸터 메뉴"><a href={`${SITE}/service`}>서비스</a><a href={`${SITE}/pricing`}>요금안내</a><a href={link()}>블로그</a><a href={`${SITE}/contact`}>도입문의</a></nav>
  </div>
  <div class="foot-bottom">
   <div>
    <div class="foot-legal"><a href="/terms">이용약관</a><a href="/privacy"><b>개인정보처리방침</b></a><a href="/refund">환불정책</a></div>
    <div class="foot-info">[상호] · 대표 [이름] · 사업자등록번호 [번호] · 통신판매업 [번호]<br>[주소] · 고객센터 카톡 [채널명]<br>검토 결과는 입력 정보를 바탕으로 한 검토 도구의 결과이며, 법적 적합성을 보증하지 않습니다.<br>© 2026 LabelPass</div>
   </div>
   <div class="foot-sns"><a href="#naver" aria-label="네이버 블로그"><svg viewBox="0 0 24 24"><path d="M6.5 5.5h3.6l3.8 6V5.5h3.6v13h-3.6l-3.8-6v6H6.5z" fill="currentColor" stroke="none"/></svg></a><a href="https://instagram.com/labelpass.kr" aria-label="인스타그램"><svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6" fill="currentColor"/></svg></a><a href="#youtube" aria-label="유튜브"><svg viewBox="0 0 24 24"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9 5 3-5 3z" fill="currentColor"/></svg></a><a href="#kakao" aria-label="카카오톡"><svg viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M12 4.5c-4.7 0-8.5 3-8.5 6.6 0 2.3 1.5 4.3 3.8 5.5l-.8 3.2 3.6-2.3c.6.1 1.2.2 1.9.2 4.7 0 8.5-3 8.5-6.6S16.7 4.5 12 4.5z"/></svg></a></div>
  </div>
 </div>
</footer>
<slot name="scripts" />
<script is:inline src="/site/policies.js" defer></script>
</body>
</html>
