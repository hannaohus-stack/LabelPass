---
// src/layouts/Layout.astro
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = 'KRK Checker 블로그 — 스몰 식품 브랜드를 위한 라벨 기준 가이드', ogImage } = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:site_name" content="KRK Checker" />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: #fff; font-family: 'Pretendard', sans-serif; color: #0A0A0B; }
    ::selection { background: #0CA4F9; color: #fff; }
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-thumb { background: rgba(10,10,11,0.15); border-radius: 2px; }
  </style>
  <style is:global>
    /* ===== Blog 반응형 — React 아일랜드(BlogList/Nav/Footer)용 ===== */
    /* 기본값(데스크톱) → 768px 이하에서 모바일 값으로 전환 */
    .krk-list-head     { padding: 64px 40px 28px; }
    .krk-list-featured { padding: 20px 40px 56px; }
    .krk-list-catbar   { padding: 18px 40px; }
    .krk-list-grid     { padding: 56px 40px 96px; grid-template-columns: repeat(3, 1fr); gap: 56px 32px; }
    .krk-cattabs       { gap: 28px; overflow-x: visible; }
    .krk-featured        { grid-template-columns: 1.05fr 1fr; }
    .krk-featured__img   { border-right: 1px solid rgba(10,10,11,0.10); }
    .krk-featured__body  { padding: 28px 36px; }
    .krk-featured__title { font-size: 32px; }
    .krk-nav-inner       { padding: 18px 40px; }
    .krk-footer-top       { padding: 64px 40px 0; }
    .krk-footer-cols      { grid-template-columns: 1fr 4fr; }
    .krk-footer-colsinner { grid-template-columns: repeat(3, 1fr); gap: 40px; }
    .krk-footer-bottom    { padding: 56px 40px 0; padding-bottom: 40px; }

    @media (max-width: 768px) {
      .krk-list-head     { padding: 32px 20px 20px; }
      .krk-list-featured { padding: 8px 20px 36px; }
      .krk-list-catbar   { padding: 14px 20px; }
      .krk-list-grid     { padding: 32px 20px 56px; grid-template-columns: 1fr; gap: 36px; }
      .krk-cattabs       { gap: 18px; overflow-x: auto; }
      .krk-featured        { grid-template-columns: 1fr; }
      .krk-featured__img   { border-right: none; border-bottom: 1px solid rgba(10,10,11,0.10); }
      .krk-featured__body  { padding: 20px 22px; }
      .krk-featured__title { font-size: 22px; }
      .krk-nav-inner       { padding: 14px 20px; }
      .krk-footer-top       { padding: 40px 20px 0; }
      .krk-footer-cols      { grid-template-columns: 1fr; }
      .krk-footer-colsinner { grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
      .krk-footer-bottom    { padding: 40px 20px 0; padding-bottom: 32px; }
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
