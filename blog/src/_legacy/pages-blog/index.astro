---
// src/pages/blog/index.astro — Blog List Page
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogList from '../../components/blog/BlogList';
import type { Article } from '../../components/blog/types';

// Content Collection에서 전체 아티클 가져오기
const posts = await getCollection('blog');

// 날짜 내림차순 정렬 (신규 업로드 순)
const sorted = posts.sort((a, b) => {
  const da = a.data.date.replace(/\./g, '-');
  const db = b.data.date.replace(/\./g, '-');
  return db.localeCompare(da);
});

// Article 타입으로 변환
const articles: Article[] = sorted.map((post) => ({
  id: post.slug,
  num: post.data.num,
  cat: post.data.cat,
  title: post.data.title,
  summary: post.data.summary,
  time: post.data.time,
  src: post.data.src,
  date: post.data.date,
  featured: post.data.featured,
  thumb: post.data.thumb as any,
  image: post.data.image,
}));

// 정적 빌드에서는 요청별 UA가 없어 항상 desktop으로 고정 렌더된다.
// 반응형은 UA 분기 대신 CSS 미디어쿼리(브레이크포인트)로 처리한다.
const device = 'desktop';
---
<Layout title="블로그 — KRK Checker" description="스몰 식품 브랜드를 위한 라벨 기준 가이드. 판매 전 확인해야 할 표시 기준을 정리합니다.">
  <BlogList device={device} articles={articles} client:load />
</Layout>
