---
// BlogArticle.astro — KRK Checker Blog Article Detail Page
// Converted from BlogArticle.tsx. Accepts MDX content via <slot />.
// Usage: <BlogArticle article={...} device={...} headings={...} slug={...}><Content /></BlogArticle>

import BlogNav from './BlogNav';
import BlogFooter from './BlogFooter';
import Thumb from './Thumb';
import { ARTICLES, catLabel } from './data';
import type { Article } from './types';

interface RelatedArticle {
  id: string;
  title: string;
  cat: string;
  time: number;
  src: string[];
  thumb: string;
  image: string;
}

interface Props {
  article: {
    num: string;
    title: string;
    summary: string;
    cat: string;
    time: number;
    src: string[];
    date: string;
    featured?: boolean;
    thumb: string;
    image?: string;
  };
  device: 'desktop' | 'mobile';
  headings: { depth: number; slug: string; text: string }[];
  slug: string;
  relatedArticles?: RelatedArticle[];
}

const { article, device, headings, slug, relatedArticles } = Astro.props;

// TOC: h2 entries only
const tocItems = headings.filter((h) => h.depth === 2);

// Related: prop에서 받은 실제 아티클 사용, 없으면 fallback
const related = relatedArticles ?? ARTICLES.filter((a) => a.id !== slug).slice(0, 3);
---

<div class="page">

  <!-- Nav (showProgress=true → 하단 라인이 읽기 진행 바로 동작) -->
  <BlogNav device={device} scope="blog" showProgress={true} client:load />

  <!-- Article Header -->
  <div class="article-header">
    <div class="cat-chip">
      <span class="cat-dot"></span>
      {catLabel(article.cat)}
    </div>
    <h1 class="article-title">{article.title}</h1>
    <p class="article-summary">{article.summary}</p>
    <div class="article-meta">
      <span>{article.date}</span>
      <span class="meta-dot">·</span>
      <span>{article.time}분 읽기</span>
      <span class="meta-dot">·</span>
      <span class="src-tags">
        {article.src.map((s: string) => (
          <span class="src-tag">{s}</span>
        ))}
      </span>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="hero-wrap">
    <div class="hero-inner">
      {article.image ? (
        <img
          src={article.image}
          alt={article.title}
          style="width:100%; display:block;"
        />
      ) : (
        <Thumb kind={article.thumb} tone="light" client:load />
      )}
    </div>
  </div>

  <!-- Article Body -->
  <article class="article-body">

    <!-- Summary Box -->
    <div class="summary-box">
      <div class="summary-box__title">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <rect x="1" y="1" width="12" height="12" rx="1.5" stroke="#002D72" stroke-width="1.2" fill="none"/>
          <path d="M4 5h6M4 7.5h4.5" stroke="#002D72" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        이 글을 읽으면 알 수 있어요
      </div>
      <ul class="summary-box__list">
        <li><strong>{article.title.split(' ').slice(0, 4).join(' ')}</strong>에 대한 법규 근거와 기준</li>
        <li>작은 브랜드에서 자주 하는 실수와 놓치기 쉬운 항목</li>
        <li>판매 전 자율 점검에 활용할 수 있는 체크리스트</li>
      </ul>
    </div>

    <!-- TOC -->
    {tocItems.length > 0 && (
      <div class="toc">
        <div class="toc__label">Contents</div>
        <ol class="toc__list">
          {tocItems.map((item, i) => (
            <li class="toc__item">
              <span class="toc__num">{i + 1}</span>
              <a href={`#${item.slug}`} class="toc__link">{item.text}</a>
            </li>
          ))}
        </ol>
      </div>
    )}

    <!-- MDX Content -->
    <div class="prose">
      <slot />
    </div>

    <!-- Article CTA -->
    <div class="article-cta">
      <div class="article-cta__radial"></div>
      <div class="article-cta__body">
        <div class="article-cta__title">라벨 점검이 필요하다면, 직접 입력해보세요</div>
        <div class="article-cta__desc">
          회원가입 없이 제품 정보를 입력하면 내 라벨에 맞는 검토 결과를 확인할 수 있어요. 결과는 자율 점검 참고용입니다.
        </div>
        <div class="article-cta__btns">
          <a href="https://checker.krk.team" class="btn-primary">라벨 검토 시작하기</a>
          <a href="https://checker.krk.team/#pricing" class="btn-outline">요금 안내 보기 →</a>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="actions-row">
      <a href="/blog" class="btn-ghost">← 목록으로</a>
      <button class="btn-ghost" onclick="navigator.share ? navigator.share({title: document.title, url: location.href}) : navigator.clipboard.writeText(location.href)">공유하기</button>
    </div>

    <!-- Related Articles -->
    {related.length > 0 && (
      <div class="related">
        <div class="related__header">
          <span class="related__title">관련 글</span>
          <a href="/blog" class="related__more">전체 보기 →</a>
        </div>
        <div class="related__grid">
          {related.map((art) => (
            <a href={`/blog/${art.id}`} class="related__card">
              {art.image
                ? <img src={art.image} alt={art.title} style="width:100%; display:block;" />
                : <Thumb kind={art.thumb} tone="light" client:load />
              }
              <div class="related__cat">{catLabel(art.cat)}</div>
              <div class="related__art-title">{art.title}</div>
              <div class="related__art-meta">{art.time}분 · 기준 {art.src[0]}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>

  <div class="spacer"></div>
  <BlogFooter device={device} client:load />
</div>

<style>
  /* ── Design tokens ───────────────────────────────────── */
  :root {
    --heritage: #002D72;
    --breath:   #0CA4F9;
    --ink:      #0A0A0B;
    --ink2:     rgba(10,10,11,0.65);
    --ink3:     rgba(10,10,11,0.45);
    --ink4:     rgba(10,10,11,0.30);
    --paper:    #FFFFFF;
    --surface:  #F4F4F5;
    --tint:     #F6F9FD;
    --rule:     rgba(10,10,11,0.10);
    --ruleS:    rgba(10,10,11,0.18);
    --font-kr:  Pretendard, "Pretendard Variable", system-ui, -apple-system, sans-serif;
    --font-en:  Inter, system-ui, sans-serif;
    --shadow-float: 0 4px 20px rgba(10,10,11,0.22);
  }

  /* ── Page shell ──────────────────────────────────────── */
  .page {
    background: #fff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-kr);
  }
  /* padding-top 제거 — nav는 sticky(DOM 흐름 내)라 offset 불필요 */

  /* ── Article Header ──────────────────────────────────── */
  .article-header {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
    text-align: center;
  }
  .article-header { padding: 64px 32px 20px; }
  @media (max-width: 768px) {.article-header{ padding: 24px 22px 12px; }}

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    background: var(--surface);
    font-size: 11.5px;
    color: var(--ink2);
    margin-bottom: 24px;
    font-family: var(--font-kr);
  }
  .cat-dot {
    width: 5px; height: 5px;
    background: var(--breath);
    border-radius: 50%;
  }

  .article-title {
    font-family: var(--font-kr);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1.25;
    margin: 0 0 18px;
  }
  .article-title { font-size: 42px; }
  @media (max-width: 768px) {.article-title{ font-size: 26px; }}

  .article-summary {
    font-family: var(--font-kr);
    color: var(--ink2);
    line-height: 1.6;
    max-width: 580px;
    margin: 0 auto 28px;
  }
  .article-summary { font-size: 16px; }
  @media (max-width: 768px) {.article-summary{ font-size: 14px; }}

  .article-meta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--ink3);
    flex-wrap: wrap;
    justify-content: center;
    font-family: var(--font-kr);
  }
  .meta-dot { color: var(--ink4); }
  .src-tags { display: inline-flex; gap: 6px; }
  .src-tag {
    padding: 3px 10px;
    background: var(--tint);
    border: 1px solid rgba(12,164,249,0.18);
    border-radius: 999px;
    font-size: 11.5px;
    color: var(--heritage);
    font-weight: 500;
  }

  /* ── Hero Image ──────────────────────────────────────── */
  .hero-wrap {
    max-width: 920px;
    margin: 16px auto 0;
    width: 100%;
    box-sizing: border-box;
  }
  .hero-wrap { padding: 0 32px; }
  @media (max-width: 768px) {.hero-wrap{ padding: 0 22px; }}

  .hero-inner {
    border: 1px solid var(--rule);
    overflow: hidden;
  }

  /* ── Article Body ─────────────────────────────────────── */
  .article-body {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }
  .article-body { padding: 48px 32px 0; }
  @media (max-width: 768px) {.article-body{ padding: 30px 22px 0; }}

  /* ── Summary Box ─────────────────────────────────────── */
  .summary-box {
    background: var(--tint);
    border: 1px solid rgba(12,164,249,0.15);
    margin-bottom: 28px;
  }
  .summary-box { padding: 22px 26px; }
  @media (max-width: 768px) {.summary-box{ padding: 16px 18px; }}

  .summary-box__title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--heritage);
    margin-bottom: 12px;
    font-family: var(--font-kr);
  }
  .summary-box__title { font-size: 13px; }
  @media (max-width: 768px) {.summary-box__title{ font-size: 12.5px; }}

  .summary-box__list {
    margin: 0; padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .summary-box__list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.6;
    color: var(--ink);
    font-family: var(--font-kr);
  }
  .summary-box__list li { font-size: 14px; }
  @media (max-width: 768px) {.summary-box__list li{ font-size: 13.5px; }}
  .summary-box__list li::before {
    content: '•';
    color: var(--heritage);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* ── TOC ─────────────────────────────────────────────── */
  .toc {
    border: 1px solid var(--rule);
    display: inline-block;
    margin-bottom: 28px;
    box-sizing: border-box;
  }
  .toc { padding: 24px 28px; min-width: 260px; }
  @media (max-width: 768px) {.toc{ padding: 18px 18px; min-width: 220px; }}

  .toc__label {
    font-family: var(--font-en);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 14px;
  }
  .toc__list {
    margin: 0; padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .toc__item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--ink2);
    font-family: var(--font-kr);
  }
  .toc__item { font-size: 14px; }
  @media (max-width: 768px) {.toc__item{ font-size: 13px; }}

  .toc__num {
    font-family: var(--font-en);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--heritage);
    flex-shrink: 0;
    min-width: 20px;
  }
  .toc__link { color: inherit; text-decoration: none; }
  .toc__link:hover { color: var(--heritage); }

  /* ── Prose (MDX body) ────────────────────────────────── */
  /* Must be :global so MDX-rendered HTML gets styled */
</style>

<style is:global>
  .prose {
    font-family: Pretendard, "Pretendard Variable", system-ui, -apple-system, sans-serif;
    color: #0A0A0B;
    line-height: 1.75;
    letter-spacing: -0.01em;
  }
  .prose { font-size: 16px; }
  @media (max-width: 768px) {.prose{ font-size: 15px; }}

  .prose p { margin: 0 0 16px; text-wrap: pretty; }

  .prose h2 {
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.025em;
    color: #0A0A0B;
  }
  .prose h2 { font-size: 22px; margin: 44px 0 14px; }
  @media (max-width: 768px) {.prose h2{ font-size: 19px; margin: 32px 0 10px; }}

  .prose h3 {
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: #0A0A0B;
    margin: 28px 0 10px;
  }
  .prose h3 { font-size: 18px; }
  @media (max-width: 768px) {.prose h3{ font-size: 16px; }}

  .prose ul, .prose ol { margin: 0 0 16px; padding-left: 20px; }
  .prose li { margin-bottom: 6px; }

  /* ── Disclaimer blockquote (default) — > ⚠️ 또는 > 📍 */
  .prose blockquote {
    background: #F4F4F5;
    border: 1px solid rgba(10,10,11,0.10);
    border-radius: 6px;
    margin: 24px 0 28px;
    color: rgba(10,10,11,0.65);
    line-height: 1.7;
  }
  .prose blockquote { padding: 16px 20px; font-size: 13.5px; }
  @media (max-width: 768px) {.prose blockquote{ padding: 14px 16px; font-size: 13px; }}

  /* ── Tip blockquote — > **놓치기 쉬운 부분** 으로 시작하는 경우 */
  .prose blockquote:has(p > strong:first-child) {
    background: #F6F9FD;
    border: 1px solid rgba(12,164,249,0.2);
    border-left: 3px solid #0CA4F9;
    border-radius: 0 6px 6px 0;
    color: #0A0A0B;
  }
  .prose blockquote:has(p > strong:first-child) { padding: 20px 24px; font-size: 14.5px; }
  @media (max-width: 768px) {.prose blockquote:has(p > strong:first-child){ padding: 16px 20px; font-size: 13.5px; }}

  /* tip 라벨: MDX의 **놓치기 쉬운 부분** 텍스트를 상단 라벨로 표시 */
  .prose blockquote:has(p > strong:first-child) p > strong:first-child {
    display: block;
    font-family: Inter, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #002D72;
    margin-bottom: 6px;
  }

  .prose blockquote p { margin: 0; }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 8px 0 28px;
    color: #0A0A0B;
  }
  .prose table { font-size: 14px; }
  @media (max-width: 768px) {.prose table{ font-size: 13px; }}

  .prose th {
    text-align: left;
    font-weight: 600;
    background: #F4F4F5;
    border-bottom: 1px solid rgba(10,10,11,0.18);
  }
  .prose th { padding: 14px 16px; }
  @media (max-width: 768px) {.prose th{ padding: 10px 12px; }}

  .prose td {
    color: rgba(10,10,11,0.65);
    border-bottom: 1px solid rgba(10,10,11,0.10);
    vertical-align: top;
  }
  .prose td { padding: 14px 16px; }
  @media (max-width: 768px) {.prose td{ padding: 10px 12px; }}

  .prose hr {
    border: none;
    border-top: 1px solid rgba(10,10,11,0.10);
    margin: 32px 0;
  }

  .prose strong { font-weight: 700; }
  .prose a { color: #0CA4F9; text-decoration: none; }
  .prose a:hover { text-decoration: underline; }

  .prose code {
    font-size: 13px;
    background: #F4F4F5;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: ui-monospace, monospace;
  }

  /* hr 뒤에 오는 h2 (자주 묻는 질문 등 부록 섹션) — 번호 없음 유지 */
</style>

<style>
  /* ── Article CTA ─────────────────────────────────────── */
  .article-cta {
    position: relative;
    overflow: hidden;
    background: var(--tint);
    border: 1px solid rgba(12,164,249,0.22);
  }
  .article-cta { padding: 40px 44px; margin: 72px 0 0; }
  @media (max-width: 768px) {.article-cta{ padding: 28px 24px; margin: 48px 0 0; }}

  .article-cta__radial {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 120% at 92% 8%, rgba(12,164,249,0.12), transparent 60%);
    pointer-events: none;
  }
  .article-cta__body { position: relative; }

  .article-cta__title {
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--heritage);
    font-family: var(--font-kr);
  }
  .article-cta__title { font-size: 26px; margin-bottom: 12px; }
  @media (max-width: 768px) {.article-cta__title{ font-size: 20px; margin-bottom: 10px; }}

  .article-cta__desc {
    font-family: var(--font-kr);
    line-height: 1.6;
    color: var(--ink2);
    max-width: 460px;
  }
  .article-cta__desc { font-size: 14.5px; margin-bottom: 24px; }
  @media (max-width: 768px) {.article-cta__desc{ font-size: 13px; margin-bottom: 18px; }}

  .article-cta__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 768px) {.article-cta__btns{ gap: 8px; }}

  .btn-primary {
    font-family: var(--font-kr);
    font-weight: 700;
    color: #fff;
    background: var(--heritage);
    text-decoration: none;
  }
  .btn-primary { font-size: 14px; padding: 12px 22px; }
  @media (max-width: 768px) {.btn-primary{ font-size: 13px; padding: 10px 18px; }}

  .btn-outline {
    font-family: var(--font-kr);
    font-weight: 600;
    color: var(--heritage);
    border: 1px solid rgba(12,164,249,0.22);
    background: var(--paper);
    text-decoration: none;
  }
  .btn-outline { font-size: 13.5px; padding: 11px 18px; }
  @media (max-width: 768px) {.btn-outline{ font-size: 12.5px; padding: 9px 14px; }}

  /* ── Actions Row ─────────────────────────────────────── */
  .actions-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--rule);
  }
  .actions-row { margin-top: 48px; padding-top: 32px; }
  @media (max-width: 768px) {.actions-row{ margin-top: 32px; padding-top: 24px; }}

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--ruleS);
    background: #fff;
    font-family: var(--font-kr);
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
  }
  .btn-ghost { font-size: 13px; padding: 10px 16px; }
  @media (max-width: 768px) {.btn-ghost{ font-size: 12.5px; padding: 9px 14px; }}

  /* ── Related Articles ────────────────────────────────── */
  .related { }
  .related { padding: 88px 0 96px; }
  @media (max-width: 768px) {.related{ padding: 64px 0 64px; }}

  .related__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .related__header { margin-bottom: 32px; }
  @media (max-width: 768px) {.related__header{ margin-bottom: 22px; }}

  .related__title {
    font-family: var(--font-kr);
    font-weight: 700;
    letter-spacing: -0.022em;
    color: var(--ink);
  }
  .related__title { font-size: 20px; }
  @media (max-width: 768px) {.related__title{ font-size: 17px; }}

  .related__more {
    font-family: var(--font-kr);
    font-size: 12px;
    color: var(--ink3);
    text-decoration: none;
  }

  .related__grid {
    display: grid;
    gap: 24px;
  }
  .related__grid { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 768px) {.related__grid{ grid-template-columns: 1fr; gap: 28px; }}

  .related__card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .related__cat {
    font-family: var(--font-kr);
    font-size: 11.5px;
    color: var(--ink3);
    margin-top: 2px;
  }
  .related__art-title {
    font-family: var(--font-kr);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .related__art-title { font-size: 15.5px; }
  @media (max-width: 768px) {.related__art-title{ font-size: 14.5px; }}

  .related__art-meta {
    font-family: var(--font-kr);
    font-size: 11.5px;
    color: var(--ink3);
  }

  /* ── Spacer / Footer ─────────────────────────────────── */
  .spacer { flex: 1; }
  .spacer { height: 96px; }
  @media (max-width: 768px) {.spacer{ height: 56px; }}
</style>
