{
  "installCommand": "npm install",
  "buildCommand": "BLOG_STANDALONE=1 npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "rewrites": [
    {
      "source": "/blog/images/:path*",
      "destination": "/images/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blog.krk.team"
        }
      ],
      "destination": "https://blog.labelpass.kr/:path*",
      "permanent": true
    },
    {
      "source": "/krk-checker-label-review-result",
      "destination": "/labelpass-label-review-result",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path+",
      "destination": "/:path+",
      "permanent": true
    }
  ]
}
